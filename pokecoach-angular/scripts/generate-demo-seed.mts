/**
 * Génère demo.generated.sql à partir des fixtures mock Angular (ex-localStorage).
 * Source de vérité : src/testing/fixtures/demo-teams.ts + demo-reports.ts
 */
import { writeFileSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import {
  DEMO_OPPONENT_TEAM,
  DEMO_TEAM_EMPTY,
  DEMO_TEAM_WITH_MATCHUP,
} from '../src/testing/fixtures/demo-teams.ts';
import { buildMockMatchupReport } from '../src/testing/fixtures/demo-reports.ts';
import type { Team } from '../src/app/core/models/team.model.ts';

const __dirname = dirname(fileURLToPath(import.meta.url));

const IDS = {
  chompy: 'a1111111-1111-4111-8111-111111111101',
  empty: 'a1111111-1111-4111-8111-111111111102',
  opponent: 'b2222222-2222-4222-8222-222222222201',
  matchup: 'c3333333-3333-4333-8333-333333333301',
} as const;

function sqlString(value: string): string {
  return `'${value.replace(/'/g, "''")}'`;
}

function dollarTag(content: string, prefix: string): string {
  let tag = prefix;
  while (content.includes(`$${tag}$`)) {
    tag = `${prefix}_${Math.random().toString(36).slice(2, 8)}`;
  }
  return `$${tag}$${content}$${tag}$`;
}

function teamInsert(id: string, kind: 'owned' | 'opponent', team: Team): string {
  const { source } = team;
  const pokemonJson = JSON.stringify(team.pokemon);
  return `
INSERT INTO core.teams (id, kind, name, source_kind, source_url, source_text, pokemon, created_at)
VALUES (
  '${id}'::uuid,
  '${kind}',
  ${sqlString(team.name)},
  '${source.kind}',
  ${source.url ? sqlString(source.url) : 'NULL'},
  ${sqlString(source.rawText)},
  ${dollarTag(pokemonJson, 'pokemon')}::jsonb,
  ${sqlString(team.createdAt)}::timestamptz
)
ON CONFLICT (id) DO UPDATE SET
  kind = EXCLUDED.kind,
  name = EXCLUDED.name,
  source_kind = EXCLUDED.source_kind,
  source_url = EXCLUDED.source_url,
  source_text = EXCLUDED.source_text,
  pokemon = EXCLUDED.pokemon,
  created_at = EXCLUDED.created_at,
  is_deleted = false;
`;
}

const report = buildMockMatchupReport(
  { ...DEMO_TEAM_WITH_MATCHUP, id: IDS.chompy },
  { ...DEMO_OPPONENT_TEAM, id: IDS.opponent },
);
const reportJson = JSON.stringify(report);

const sql = `-- Generated by pokecoach-angular/scripts/generate-demo-seed.mts — do not edit by hand.
${teamInsert(IDS.chompy, 'owned', { ...DEMO_TEAM_WITH_MATCHUP, id: IDS.chompy })}
${teamInsert(IDS.empty, 'owned', { ...DEMO_TEAM_EMPTY, id: IDS.empty })}
${teamInsert(IDS.opponent, 'opponent', { ...DEMO_OPPONENT_TEAM, id: IDS.opponent })}

INSERT INTO core.matchups (id, our_team_id, opponent_team_id)
VALUES (
  '${IDS.matchup}'::uuid,
  '${IDS.chompy}'::uuid,
  '${IDS.opponent}'::uuid
)
ON CONFLICT (id) DO UPDATE SET
  our_team_id = EXCLUDED.our_team_id,
  opponent_team_id = EXCLUDED.opponent_team_id,
  is_deleted = false;

DELETE FROM core.matchup_runs
WHERE matchup_id = '${IDS.matchup}'::uuid;

INSERT INTO core.matchup_runs (matchup_id, source, status, report, finished_at, provenance)
VALUES (
  '${IDS.matchup}'::uuid,
  'mock',
  'succeeded',
  ${dollarTag(reportJson, 'report')}::jsonb,
  '2026-10-01T10:30:00.000Z'::timestamptz,
  '{"fixtureVersion":1}'::jsonb
);
`;

const outPath = resolve(
  __dirname,
  '../../../pokecoach2-conception/tests/fixtures/demo.generated.sql',
);
writeFileSync(outPath, sql.trimStart(), 'utf8');
console.log(`Wrote ${outPath}`);
