/**
 * Génère demo.generated.sql et demo.manifest.json à partir des fixtures mock Angular.
 */
import { createHash } from 'node:crypto';
import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import {
  DEMO_OPPONENT_TEAM,
  DEMO_TEAM_EMPTY,
  DEMO_TEAM_WITH_MATCHUP,
} from '../src/testing/fixtures/demo-teams.ts';
import { buildMockMatchupReport } from '../src/testing/fixtures/demo-reports.ts';
import type { Team } from '../src/app/core/models/team.model.ts';

const __dirname = dirname(fileURLToPath(import.meta.url));

const IDS = {
  chompy: 'a1111111-1111-4111-8111-111111111101',
  empty: 'a1111111-1111-4111-8111-111111111102',
  opponent: 'b2222222-2222-4222-8222-222222222201',
  matchup: 'c3333333-3333-4333-8333-333333333301',
} as const;

const FIXTURE_VERSION = 1;

export function sqlString(value: string): string {
  return `'${value.replace(/'/g, "''")}'`;
}

export function dollarTag(content: string, prefix: string): string {
  let tag = prefix;
  let suffix = 0;
  while (content.includes(`$${tag}$`)) {
    suffix += 1;
    tag = `${prefix}_${suffix}`;
  }
  return `$${tag}$\n${content}$${tag}$`;
}

function teamToManifest(id: string, kind: 'owned' | 'opponent', team: Team) {
  return {
    id,
    kind,
    name: team.name,
    sourceKind: team.source.kind,
    sourceUrl: team.source.url,
    sourceText: team.source.rawText,
    pokemon: team.pokemon,
    createdAt: team.createdAt,
  };
}

export function buildDemoManifest() {
  const chompyTeam = { ...DEMO_TEAM_WITH_MATCHUP, id: IDS.chompy };
  const emptyTeam = { ...DEMO_TEAM_EMPTY, id: IDS.empty };
  const opponentTeam = { ...DEMO_OPPONENT_TEAM, id: IDS.opponent };
  const report = buildMockMatchupReport(chompyTeam, opponentTeam);

  return {
    fixtureVersion: FIXTURE_VERSION,
    teams: [
      teamToManifest(IDS.chompy, 'owned', chompyTeam),
      teamToManifest(IDS.empty, 'owned', emptyTeam),
      teamToManifest(IDS.opponent, 'opponent', opponentTeam),
    ],
    matchup: {
      id: IDS.matchup,
      ourTeamId: IDS.chompy,
      opponentTeamId: IDS.opponent,
    },
    run: {
      source: 'mock',
      reportVersion: 1,
      status: 'succeeded',
      report,
      finishedAt: '2026-10-01T10:30:00.000Z',
      provenance: { fixtureVersion: FIXTURE_VERSION },
    },
  };
}

function teamInsert(id: string, kind: 'owned' | 'opponent', team: Team): string {
  const { source } = team;
  const pokemonJson = JSON.stringify(team.pokemon);
  return `
INSERT INTO core.teams (id, kind, name, source_kind, source_url, source_text, pokemon, created_at)
VALUES (
  '${id}'::uuid,
  '${kind}',
  ${sqlString(team.name)},
  '${source.kind}',
  ${source.url ? sqlString(source.url) : 'NULL'},
  ${sqlString(source.rawText)},
  ${dollarTag(pokemonJson, 'pokemon')}::jsonb,
  ${sqlString(team.createdAt)}::timestamptz
)
ON CONFLICT (id) DO UPDATE SET
  kind = EXCLUDED.kind,
  name = EXCLUDED.name,
  source_kind = EXCLUDED.source_kind,
  source_url = EXCLUDED.source_url,
  source_text = EXCLUDED.source_text,
  pokemon = EXCLUDED.pokemon,
  created_at = EXCLUDED.created_at,
  is_deleted = false;
`;
}

export function buildDemoGeneratedSql(manifest: ReturnType<typeof buildDemoManifest>): string {
  const chompy = manifest.teams[0]!;
  const empty = manifest.teams[1]!;
  const opponent = manifest.teams[2]!;
  const reportJson = JSON.stringify(manifest.run.report);

  const chompyTeam: Team = {
    id: chompy.id,
    name: chompy.name,
    kind: chompy.kind,
    source: {
      kind: chompy.sourceKind as Team['source']['kind'],
      url: chompy.sourceUrl,
      rawText: chompy.sourceText,
    },
    pokemon: chompy.pokemon,
    createdAt: chompy.createdAt,
  };
  const emptyTeam: Team = {
    id: empty.id,
    name: empty.name,
    kind: empty.kind,
    source: {
      kind: empty.sourceKind as Team['source']['kind'],
      url: empty.sourceUrl,
      rawText: empty.sourceText,
    },
    pokemon: empty.pokemon,
    createdAt: empty.createdAt,
  };
  const opponentTeam: Team = {
    id: opponent.id,
    name: opponent.name,
    kind: opponent.kind,
    source: {
      kind: opponent.sourceKind as Team['source']['kind'],
      url: opponent.sourceUrl,
      rawText: opponent.sourceText,
    },
    pokemon: opponent.pokemon,
    createdAt: opponent.createdAt,
  };

  return `-- Generated by pokecoach-angular/scripts/generate-demo-seed.mts — do not edit by hand.
${teamInsert(chompy.id, 'owned', chompyTeam)}
${teamInsert(empty.id, 'owned', emptyTeam)}
${teamInsert(opponent.id, 'opponent', opponentTeam)}

INSERT INTO core.matchups (id, our_team_id, opponent_team_id)
VALUES (
  '${manifest.matchup.id}'::uuid,
  '${manifest.matchup.ourTeamId}'::uuid,
  '${manifest.matchup.opponentTeamId}'::uuid
)
ON CONFLICT (id) DO UPDATE SET
  our_team_id = EXCLUDED.our_team_id,
  opponent_team_id = EXCLUDED.opponent_team_id,
  is_deleted = false;

DELETE FROM core.matchup_runs
WHERE matchup_id = '${manifest.matchup.id}'::uuid;

INSERT INTO core.matchup_runs (matchup_id, source, status, report, finished_at, provenance)
VALUES (
  '${manifest.matchup.id}'::uuid,
  '${manifest.run.source}',
  '${manifest.run.status}',
  ${dollarTag(reportJson, 'report')}::jsonb,
  '${manifest.run.finishedAt}'::timestamptz,
  '${JSON.stringify(manifest.run.provenance)}'::jsonb
);
`.trimStart();
}

function stableHash(content: string): string {
  return createHash('sha256').update(content).digest('hex');
}

const manifest = buildDemoManifest();
const sql = buildDemoGeneratedSql(manifest);
const manifestJson = `${JSON.stringify(manifest, null, 2)}\n`;

const sqlOutPath = resolve(
  __dirname,
  '../../../pokecoach2-conception/tests/fixtures/demo.generated.sql',
);
const manifestOutPath = resolve(
  __dirname,
  '../../../pokecoach2-conception/tests/fixtures/demo.manifest.json',
);

const checkMode = process.argv.includes('--check');

if (checkMode) {
  const expectedSql = readFileSync(sqlOutPath, 'utf8');
  const expectedManifest = readFileSync(manifestOutPath, 'utf8');
  if (stableHash(sql) !== stableHash(expectedSql)) {
    console.error('demo.generated.sql is out of date — run npm run generate:demo-seed');
    process.exit(1);
  }
  if (stableHash(manifestJson) !== stableHash(expectedManifest)) {
    console.error('demo.manifest.json is out of date — run npm run generate:demo-seed');
    process.exit(1);
  }
  console.log('Demo seed artifacts are up to date.');
  process.exit(0);
}

writeFileSync(sqlOutPath, sql, 'utf8');
writeFileSync(manifestOutPath, manifestJson, 'utf8');
console.log(`Wrote ${sqlOutPath}`);
console.log(`Wrote ${manifestOutPath}`);
